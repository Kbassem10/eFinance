{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/StudentRegistrationPortal.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/StudentRegistrationPortal.Api.csproj",
        "-c",
        "Debug",
        "-r",
        "linux-x64",
        "--self-contained",
        "true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
